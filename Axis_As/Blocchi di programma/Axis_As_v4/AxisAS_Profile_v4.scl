FUNCTION_BLOCK "AxisAS_Profile_v4"
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : FMT
FAMILY : AxisAS
VERSION : 0.2
//Generatore di velocità TRAPEZIO con jerk limitato (profilo a S) per AxisAS_Mng_v4.
//Lavora ciclo per ciclo: segue la velocità obiettivo ifCmdSpeed con accelerazione massima ifAcc,
//decelerazione massima ifDec e variazione massima dell'accelerazione ifJerk.
//ifJerk = 0 -> trapezio puro (accelerazione a gradino).
//Se la velocità obiettivo cambia a metà rampa, l'accelerazione si adegua senza salti.
   VAR_INPUT
      ifCmdSpeed : Real;   // Velocità obiettivo (>= 0)
      ifAcc : Real;   // Accelerazione massima (unità/s^2)
      ifDec : Real;   // Decelerazione massima (unità/s^2)
      ifJerk : Real;   // Jerk (unità/s^3). 0 = trapezio puro
      ifDt : Real;   // Tempo ciclo (s)
      ixReset : Bool;   // Azzera profilo (velocità e accelerazione = 0)
   END_VAR

   VAR_OUTPUT
      ofSpeed : Real;   // Velocità generata (>= 0)
      ofAcc : Real;   // Accelerazione attuale (+ accelera, - decelera)
      oxAcc : Bool;   // Accelerazione in corso
      oxDec : Bool;   // Decelerazione in corso
      oxDone : Bool;   // Velocità = obiettivo
   END_VAR

   VAR
      fV : Real;   // Velocità attuale
      fA : Real;   // Accelerazione attuale
   END_VAR

   VAR_TEMP
      tfCmd : Real;
      tfDv : Real;
      tfJ : Real;
      tfVNew : Real;
   END_VAR


BEGIN
	REGION Reset
	    #tfCmd := #ifCmdSpeed;
	    IF #ixReset THEN
	        #fV := 0.0;
	        #fA := 0.0;
	        #tfCmd := 0.0;
	    END_IF;
	    IF #tfCmd < 0.0 THEN
	        #tfCmd := 0.0;
	    END_IF;
	END_REGION

	REGION Accelerazione
	    #tfDv := #tfCmd - #fV;
	    IF #ifJerk <= 0.0 THEN
	        // trapezio puro
	        IF #tfDv > 0.0 THEN
	            #fA := #ifAcc;
	        ELSIF #tfDv < 0.0 THEN
	            #fA := -#ifDec;
	        ELSE
	            #fA := 0.0;
	        END_IF;
	    ELSE
	        #tfJ := #ifJerk * #ifDt;
	        IF #tfDv > 0.0 THEN
	            // devo accelerare: se riportando a zero l'accelerazione arrivo già all'obiettivo, inizio a ridurla
	            IF #fA > 0.0 AND #tfDv <= #fA * #fA / (2.0 * #ifJerk) THEN
	                #fA := #fA - #tfJ;
	                IF #fA < 0.0 THEN
	                    #fA := 0.0;
	                END_IF;
	            ELSE
	                #fA := #fA + #tfJ;
	                IF #fA > #ifAcc THEN
	                    #fA := #ifAcc;
	                END_IF;
	            END_IF;
	        ELSIF #tfDv < 0.0 THEN
	            // devo decelerare
	            IF #fA < 0.0 AND -#tfDv <= #fA * #fA / (2.0 * #ifJerk) THEN
	                #fA := #fA + #tfJ;
	                IF #fA > 0.0 THEN
	                    #fA := 0.0;
	                END_IF;
	            ELSE
	                #fA := #fA - #tfJ;
	                IF #fA < -#ifDec THEN
	                    #fA := -#ifDec;
	                END_IF;
	            END_IF;
	        ELSE
	            #fA := 0.0;
	        END_IF;
	    END_IF;
	END_REGION

	REGION Velocità
	    #tfVNew := #fV + #fA * #ifDt;
	    // obiettivo raggiunto o superato: aggancio
	    IF (#tfDv > 0.0 AND #tfVNew >= #tfCmd) OR (#tfDv < 0.0 AND #tfVNew <= #tfCmd) OR (#tfDv = 0.0) THEN
	        #fV := #tfCmd;
	        #fA := 0.0;
	    ELSE
	        #fV := #tfVNew;
	    END_IF;
	    IF #fV < 0.0 THEN
	        #fV := 0.0;
	        #fA := 0.0;
	    END_IF;
	END_REGION

	REGION Uscite
	    #ofSpeed := #fV;
	    #ofAcc := #fA;
	    #oxDone := (#fV = #tfCmd) AND (#fA = 0.0);
	    #oxAcc := #fA > 0.0;
	    #oxDec := #fA < 0.0;
	END_REGION
END_FUNCTION_BLOCK

