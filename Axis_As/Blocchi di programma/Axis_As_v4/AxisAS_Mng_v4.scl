FUNCTION_BLOCK "AxisAS_Mng_v4"
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : FMT
FAMILY : AxisAS
VERSION : 0.2
//------------------------------------------------------------------------
//DESCRIPTION: "AxisAS_Mng_v4"
//    Gestore ASSE per motore asincrono su inverter (marcia avanti/indietro + riferimento velocità + freno)
//    con posizionatore a profilo TRAPEZIO con jerk limitato. Due modi (Cfg.xPosLoop):
//    - FALSE (default): il riferimento al motore è il profilo; tutte le decisioni (inizio decelerazione,
//      arrivo) sono prese sulla posizione reale dell'encoder. Robusto con meccaniche a forte inerzia.
//    - TRUE: inseguimento di un asse virtuale. Riferimento = velocità profilo + anticipo accelerazione
//      (accelerazione x tAdvStop) + correzione proporzionale Cfg.fKp_Pos sull'errore virtuale-encoder,
//      limitata a Cfg.fPosLoopLimitPct. Tempi ripetibili, necessario per coordinare più assi.
//      Il riferimento può superare fMaxSpeed della correzione: tenere fMaxSpeed sotto il massimo dell'inverter.
//
//FUNZIONI:
//    - Posizionamento: accelerazione, regime, decelerazione fino a Cfg.fMinSpeed, accostamento lento,
//      stop in finestra Cfg.fMotWindPos con motore fermo. Se l'inerzia porta oltre la quota,
//      attende l'arresto e torna in quota a velocità minima.
//    - Autocalcolo velocità sullo spazio da percorrere e acc/dec proporzionali alla velocità
//    - Cambio quota in movimento (stessa direzione) oppure arresto e ripartenza
//    - Ricerca livello con sensore esterno in entrambi i sensi
//    - JOG con posizionatore disabilitato
//    - Gestione freno, attesa inverter magnetizzato, mantenimento marcia dopo l'arresto
//    - Diagnostica di taratura: superamento quota e errore finale dell'ultimo posizionamento
//    - Allarmi (owErrorId): 1 asse bloccato/encoder invertito, 2 timeout fine posizionamento,
//      3 abort in moto, 4 inverter non pronto, 5 riservato sincro, 6 parametri non validi,
//      7 inverter perso in moto, 8 errore di inseguimento (solo xPosLoop, Cfg.fMaxErrEnc)
//    - Tempo ciclo misurato internamente (RUNTIME): chiamare in OB ciclico o OB1
//
//STATI (oiState): 0 Disabilitato | 10 Pronto/fermo | 20 Attesa inverter | 30 Movimento
//                 40 Accostamento finale | 50 Arresto in rampa | 60 Chiusura freno
//                 70 JOG attesa inverter | 71 JOG | 99 Errore
//
//TARATURA:
//    1) fJerk = 0 (trapezio puro), poi aumentare la morbidezza con fJerk ~ 5..10 x accelerazione
//    2) inerzia: tAdvStop ~ tempo di risposta della meccanica (ritardo tra riferimento e velocità reale).
//       Dopo alcuni posizionamenti leggere ofOvershoot (superamento quota) alla velocità V:
//       se > 0 aumentare tAdvStop di circa ofOvershoot / V; se l'accostamento lento è lungo, diminuirlo.
//    3) fMotAdvStopPosition: anticipo fisso in mm (es. ritardo chiusura freno), indipendente dalla velocità
//    4) solo xPosLoop: tarare prima tAdvStop (anticipo), poi fKp_Pos guardando ofFollowingError;
//       fMaxErrEnc qualche volta più grande del massimo errore visto in ofMaxFollowingError
//
//NOTE INVERTER (Siemens, invariato da v2.0):
//    rampe generate nel PLC (p1120 = p1121 = 0), p1300 = 1 U/f lineare + FCC, freno p1215 = 3,
//    p1216 = 50 ms, p1217 = 40 ms, OFF3 p1135 = 0,020 s, limite corrente 2 x In, boost p1310 = 50% p1311 = 25%.
//
//CHANGELOG:
//    v4.0 - 17/11/2026 - Prima stesura (FMT): riscrittura da zero di AxisAS_Mng_v2.0
//------------------------------------------------------------------------
   VAR_INPUT
      ixEnable : Bool;   // Abilita posizionatore (con FALSE durante il moto: arresto in rampa)
      ifPositionRequest : Real;   // Quota richiesta (mm o gradi). Una variazione avvia il movimento
      ifSpeedRequest : Real;   // Velocità richiesta (unità/s)
      ifAccRamp : Real;   // Accelerazione richiesta (unità/s^2)
      ifDecRamp : Real;   // Decelerazione richiesta (unità/s^2)
      ixAutoSpeed : Bool;   // Riduce la velocità sugli spostamenti brevi (retta Cfg.fThreshold_xxx)
      ixAutoAccDec : Bool;   // Acc/dec proporzionali alla velocità (Cfg.fMaxAccRamp/fMaxDecRamp a fMaxSpeed)
      ixJogPos : Bool;   // JOG + (solo con ixEnable = FALSE)
      ixJogNeg : Bool;   // JOG - (solo con ixEnable = FALSE)
      ixLevelSearch : Bool;   // Abilita ricerca livello
      ixLevelSensor : Bool;   // Sensore livello raggiunto
      ifPositionStartLev : Real;   // Quota a cui deve essere già raggiunta la velocità di ricerca
      ifSpeedLev : Real;   // Velocità di ricerca livello (unità/s)
      ixDriveReady : Bool;   // Inverter pronto / motore magnetizzato
      ixMotorReadyReq : Bool;   // Richiesta esterna di magnetizzazione (fronte di salita)
      ixAbort : Bool;   // Arresto immediato (in movimento genera allarme)
      ixReset : Bool;   // Reset allarmi (fronte di salita)
      ifEncoder : Real;   // Posizione attuale encoder (mm o gradi)
   END_VAR

   VAR_OUTPUT
      oxCmdMotorForw : Bool;   // Marcia avanti
      oxCmdMotorBack : Bool;   // Marcia indietro
      oxCmdBrake : Bool;   // Sblocco freno
      ofSpeedRequest : Real;   // Riferimento velocità motore (modulo, unità/s)
      oxEndPos : Bool;   // In posizione (finestra Cfg.fMotWindPos, motore fermo)
      oxEndPosBig : Bool;   // In finestra allargata (Cfg.fMotWindPosBig)
      oxStopSpeed : Bool;   // Riferimento velocità = 0
      oxBusy : Bool;   // Movimento in corso
      oxAccOnWork : Bool;   // Accelerazione in corso
      oxDecOnWork : Bool;   // Decelerazione in corso
      oxLevelReached : Bool;   // Ricerca livello: sensore trovato, asse fermo
      oxLevelNotFound : Bool;   // Ricerca livello: quota raggiunta senza sensore
      oxPosError : Bool;   // Allarme attivo
      owErrorId : Word;   // Codice allarme
      oiState : Int;   // Stato macchina a stati
      ofProfileSpeed : Real;   // Velocità del profilo con segno (per coordinamento assi)
      ofProfileAcc : Real;   // Accelerazione del profilo con segno (per coordinamento assi)
      ofActualPos : Real;   // Posizione encoder (mm)
      ofActualSpeed : Real;   // Velocità reale stimata dall'encoder (con segno)
      ofVirPos : Real;   // Posizione asse virtuale (profilo integrato)
      ofFollowingError : Real;   // Errore di inseguimento: virtuale - encoder (nel senso del moto)
      ofMaxFollowingError : Real;   // Massimo errore di inseguimento (azzerato al reset o ad ogni movimento)
      ofSpaceStop : Real;   // Spazio di arresto dalla velocità attuale
      ofSpaceStart : Real;   // Spazio di accelerazione fino alla velocità di crociera
      ofSpaceLevRes : Real;   // Spazio per passare alla velocità di ricerca livello
      ofOvershoot : Real;   // Ultimo posizionamento: massimo superamento della quota (> 0 = oltre)
      ofStopError : Real;   // Ultimo posizionamento: errore finale (encoder - quota)
      otTimeMove : Time;   // Durata ultimo posizionamento
      ofTarget : Real;   // Quota obiettivo del movimento in corso
      ofSpeedMove : Real;   // Velocità di crociera di lavoro (dopo autocalcolo e limiti)
      ofAccWork : Real;   // Accelerazione di lavoro (dopo autocalcolo e limiti)
      ofDecWork : Real;   // Decelerazione di lavoro (dopo autocalcolo e limiti)
   END_VAR

   VAR_IN_OUT
      Cfg : "AxisAS_CFG_Type_v4";   // Configurazione asse (non viene mai modificata dal blocco)
   END_VAR

   VAR
      Profile : "AxisAS_Profile_v4";   // Generatore di velocità
      Sincro : "AxixAS_DataSincro_Type_v2.0";   // Predisposizione coordinamento assi (non usato)
      iState : Int;   // Stato attuale
      iPrevState : Int;   // Stato ciclo precedente
      iNextState : Int;   // Stato dopo chiusura freno
      wError : Word;   // Codice allarme
      lrRuntimeMem : LReal;   // Memoria istruzione RUNTIME
      xInitDone : Bool;   // Primo ciclo eseguito
      fDt : Real;   // Tempo ciclo (s)
      fStateTime : Real;   // Tempo nello stato attuale (s)
      fKeepAlive : Real;   // Tempo residuo mantenimento marcia (s)
      fMoveTime : Real;   // Durata movimento in corso (s)
      fStallTime : Real;   // Tempo con motore comandato e encoder fermo (s)
      fEncOld : Real;   // Posizione encoder ciclo precedente
      fEncChgT : Real;   // Tempo dall'ultimo cambio del valore encoder [s]
      fEncSpeed : Real;   // Velocità reale stimata dall'encoder (filtrata)
      fTarget : Real;   // Quota obiettivo in corso
      fAcceptedRequest : Real;   // Ultima quota richiesta accettata
      fNewTarget : Real;   // Quota per avvio movimento
      rDir : Real;   // Direzione movimento: +1 avanti, -1 indietro
      rLastDir : Real;   // Ultima direzione comandata (mantenimento marcia)
      rOutDir : Real;   // Direzione uscita motore
      fOutSpeed : Real;   // Velocità uscita motore (modulo)
      fOutSpeedOld : Real;   // Velocità uscita ciclo precedente
      fProfSpeed : Real;   // Velocità del profilo (modulo)
      fSpeedMove : Real;   // Velocità di crociera del movimento
      fAccWork : Real;   // Accelerazione di lavoro
      fDecWork : Real;   // Decelerazione di lavoro
      fMaxOvershoot : Real;   // Superamento quota nel posizionamento in corso
      fVirPos : Real;   // Posizione asse virtuale
      xStartMove : Bool;   // Richiesta avvio movimento (gestita dopo la macchina a stati)
      xRestart : Bool;   // Dopo l'arresto in rampa riparte verso fTarget
      xDecel : Bool;   // Decelerazione verso la quota iniziata
      xSettleCreep : Bool;   // Accostamento finale: correzione a velocità minima in corso
      xLevelPhase : Bool;   // Ricerca livello: velocità di ricerca
      xLevelFound : Bool;   // Ricerca livello: sensore trovato
      xLevelNotFound : Bool;   // Ricerca livello: quota raggiunta senza sensore
      xBrakeOpen : Bool;   // Freno sbloccato
      xFirstStandby : Bool;   // Primo ciclo in stato Pronto dopo l'abilitazione
      xResetOld : Bool;   // Fronte reset
      xMotorReqOld : Bool;   // Fronte richiesta magnetizzazione
   END_VAR

   VAR_TEMP
      tlrDt : LReal;
      tfRem : Real;   // Spazio residuo (encoder) nella direzione del moto
      tfRemNew : Real;
      tfVEnd : Real;   // Velocità di accostamento
      tfVCruise : Real;
      tfCmd : Real;
      tfErr : Real;
      tfDist : Real;
      tfMaxSpeed : Real;
      tfBrakeDelay : Real;
      tfX : Real;
      tfM : Real;
      tfAccAlong : Real;   // Accelerazione del profilo se positiva (per calcolo spazio)
      tfAdv : Real;   // Anticipo di arresto per inerzia (s)
      tfPred : Real;   // Spazio residuo previsto a motore fermo
      tfPosRef : Real;   // Posizione per le decisioni: virtuale (xPosLoop) o encoder
      tfLagComp : Real;   // Anticipo per ritardo meccanica nello spazio di arresto (solo senza xPosLoop)
      tfP : Real;   // Correzione proporzionale
      tfPLim : Real;   // Limite correzione
      tfFErr : Real;   // Errore di inseguimento
      txProfileReset : Bool;
      txActive : Bool;
      txResetPulse : Bool;
   END_VAR

   VAR CONSTANT
      ENC_FILT_T : Real := 0.03;   // Costante di tempo filtro velocità encoder [s]
      ENC_STILL_T : Real := 0.1;   // Encoder fermo da più di questo tempo -> velocità verso zero [s]
      ST_DISABLED : Int := 0;
      ST_STANDBY : Int := 10;
      ST_START : Int := 20;
      ST_MOVING : Int := 30;
      ST_SETTLE : Int := 40;
      ST_STOPPING : Int := 50;
      ST_BRAKE : Int := 60;
      ST_JOG_START : Int := 70;
      ST_JOG : Int := 71;
      ST_ERROR : Int := 99;
      ERR_STALL : Word := 16#0001;   // Asse bloccato o encoder invertito (Cfg.tStallTime)
      ERR_ENDPOS_TIMEOUT : Word := 16#0002;   // Non in posizione entro Cfg.tCtrEndPos dall'arrivo
      ERR_ABORT : Word := 16#0003;   // Abort durante il movimento
      ERR_DRIVE_TIMEOUT : Word := 16#0004;   // Inverter non pronto entro Cfg.tDriveReadyTimeout
      ERR_SINCRO : Word := 16#0005;   // Riservato coordinamento assi
      ERR_PARAM : Word := 16#0006;   // Parametri Cfg non validi
      ERR_DRIVE_LOST : Word := 16#0007;   // Inverter non più pronto durante il movimento
      ERR_FOLLOWING : Word := 16#0008;   // Errore di inseguimento > Cfg.fMaxErrEnc (solo xPosLoop)
   END_VAR


BEGIN
	REGION Tempo ciclo, velocità reale e fronti
	    #tlrDt := RUNTIME(#lrRuntimeMem);
	    IF #xInitDone THEN
	        #fDt := LREAL_TO_REAL(#tlrDt);
	    ELSE
	        #fDt := 0.0;
	        #fEncOld := #ifEncoder;
	        #xInitDone := TRUE;
	    END_IF;
	    IF #fDt < 0.0 OR #fDt > 1.0 THEN
	        #fDt := 0.0;
	    END_IF;

	    // velocità reale dall'encoder: calcolata solo quando il valore cambia, sul tempo trascorso dall'ultimo
	    // cambio (encoder aggiornato in modo asincrono rispetto al ciclo, es. bus o simulatore), poi filtrata.
	    // Se l'encoder resta fermo più di ENC_STILL_T la velocità tende a zero.
	    #fEncChgT := #fEncChgT + #fDt;
	    IF #ifEncoder <> #fEncOld THEN
	        IF #fEncChgT > 0.0 THEN
	            #fEncSpeed := #fEncSpeed + ((#ifEncoder - #fEncOld) / #fEncChgT - #fEncSpeed) * (#fEncChgT / (#fEncChgT + #ENC_FILT_T));
	        END_IF;
	        #fEncOld := #ifEncoder;
	        #fEncChgT := 0.0;
	    ELSIF #fEncChgT > #ENC_STILL_T THEN
	        #fEncSpeed := #fEncSpeed - #fEncSpeed * (#fDt / (#fDt + #ENC_FILT_T));
	    END_IF;

	    #txResetPulse := #ixReset AND NOT #xResetOld;
	    #xResetOld := #ixReset;

	    IF #iState <> #iPrevState THEN
	        #fStateTime := 0.0;
	        #iPrevState := #iState;
	    ELSE
	        #fStateTime := #fStateTime + #fDt;
	    END_IF;

	    #xStartMove := FALSE;
	    #txProfileReset := FALSE;
	    #tfCmd := 0.0;
	    #fOutSpeed := 0.0;
	END_REGION

	REGION Parametri di lavoro
	    #tfMaxSpeed := #Cfg.fMaxSpeed;
	    IF #tfMaxSpeed <= 0.0 THEN
	        #tfMaxSpeed := 1.0;
	    END_IF;

	    // velocità di crociera: senza autocalcolo segue la richiesta anche durante il moto
	    IF NOT #ixAutoSpeed THEN
	        #fSpeedMove := #ifSpeedRequest;
	    END_IF;
	    IF #fSpeedMove > #tfMaxSpeed THEN
	        #fSpeedMove := #tfMaxSpeed;
	    END_IF;
	    IF #fSpeedMove < #Cfg.fMinSpeed THEN
	        #fSpeedMove := #Cfg.fMinSpeed;
	    END_IF;

	    // accelerazione / decelerazione
	    IF #ixAutoAccDec THEN
	        #fAccWork := #Cfg.fMaxAccRamp * (#fSpeedMove / #tfMaxSpeed);
	        #fDecWork := #Cfg.fMaxDecRamp * (#fSpeedMove / #tfMaxSpeed);
	    ELSE
	        #fAccWork := #ifAccRamp;
	        #fDecWork := #ifDecRamp;
	    END_IF;
	    IF #fAccWork < #Cfg.fMinAccRamp THEN
	        #fAccWork := #Cfg.fMinAccRamp;
	    END_IF;
	    IF #fAccWork > #Cfg.fMaxAccRamp THEN
	        #fAccWork := #Cfg.fMaxAccRamp;
	    END_IF;
	    IF #fDecWork < #Cfg.fMinDecRamp THEN
	        #fDecWork := #Cfg.fMinDecRamp;
	    END_IF;
	    IF #fDecWork > #Cfg.fMaxDecRamp THEN
	        #fDecWork := #Cfg.fMaxDecRamp;
	    END_IF;

	    #tfVEnd := #Cfg.fMinSpeed;
	    #tfAdv := DINT_TO_REAL(TIME_TO_DINT(#Cfg.tAdvStop)) / 1000.0;
	    #tfPLim := #tfMaxSpeed * #Cfg.fPosLoopLimitPct / 100.0;
	    IF #Cfg.xPosLoop THEN
	        #tfPosRef := #fVirPos;
	    ELSE
	        #tfPosRef := #ifEncoder;
	    END_IF;
	    #tfAccAlong := #Profile.ofAcc;
	    IF #tfAccAlong < 0.0 THEN
	        #tfAccAlong := 0.0;
	    END_IF;
	END_REGION

	REGION Allarmi
	    IF #txResetPulse THEN
	        #ofMaxFollowingError := 0.0;
	        IF #iState = #ST_ERROR AND NOT #ixAbort THEN
	            #wError := 0;
	            #iState := #ST_DISABLED;
	        END_IF;
	    END_IF;

	    IF #iState <> #ST_ERROR THEN
	        // abort durante il movimento
	        IF #ixAbort AND (#iState >= #ST_START) THEN
	            #wError := #ERR_ABORT;
	            #iState := #ST_ERROR;
	        END_IF;

	        // asse bloccato o encoder invertito: motore comandato ma l'encoder non avanza nella direzione giusta
	        IF (#iState = #ST_MOVING OR #iState = #ST_SETTLE OR #iState = #ST_JOG)
	            AND #fOutSpeedOld >= #Cfg.fMinSpeed AND #fOutSpeedOld > 0.0
	            AND #rOutDir * #fEncSpeed < 0.1 * #fOutSpeedOld THEN
	            #fStallTime := #fStallTime + #fDt;
	        ELSE
	            #fStallTime := 0.0;
	        END_IF;
	        IF TIME_TO_DINT(#Cfg.tStallTime) > 0
	            AND #fStallTime > DINT_TO_REAL(TIME_TO_DINT(#Cfg.tStallTime)) / 1000.0 THEN
	            #wError := #ERR_STALL;
	            #iState := #ST_ERROR;
	        END_IF;

	        // errore di inseguimento (solo con asse virtuale)
	        IF #iState = #ST_MOVING AND #Cfg.xPosLoop THEN
	            #tfFErr := ABS(#fVirPos - #ifEncoder);
	            IF #tfFErr > #ofMaxFollowingError THEN
	                #ofMaxFollowingError := #tfFErr;
	            END_IF;
	            IF #Cfg.fMaxErrEnc > 0.0 AND #tfFErr > #Cfg.fMaxErrEnc THEN
	                #wError := #ERR_FOLLOWING;
	                #iState := #ST_ERROR;
	            END_IF;
	        END_IF;

	        // timeout accostamento finale
	        IF #iState = #ST_SETTLE AND TIME_TO_DINT(#Cfg.tCtrEndPos) > 0
	            AND #fStateTime > DINT_TO_REAL(TIME_TO_DINT(#Cfg.tCtrEndPos)) / 1000.0 THEN
	            #wError := #ERR_ENDPOS_TIMEOUT;
	            #iState := #ST_ERROR;
	        END_IF;

	        // inverter perso durante il moto
	        IF #iState >= #ST_MOVING AND #iState <> #ST_JOG_START AND #xBrakeOpen AND NOT #ixDriveReady THEN
	            #wError := #ERR_DRIVE_LOST;
	            #iState := #ST_ERROR;
	        END_IF;

	        // timeout inverter pronto
	        IF (#iState = #ST_START OR #iState = #ST_JOG_START)
	            AND #fStateTime > DINT_TO_REAL(TIME_TO_DINT(#Cfg.tDriveReadyTimeout)) / 1000.0 THEN
	            #wError := #ERR_DRIVE_TIMEOUT;
	            #iState := #ST_ERROR;
	        END_IF;
	    END_IF;
	END_REGION

	REGION Macchina a stati
	    CASE #iState OF
	        0:  // ST_DISABLED
	            #fVirPos := #ifEncoder;
	            #txProfileReset := TRUE;
	            #xBrakeOpen := FALSE;
	            #xLevelFound := FALSE;
	            #xLevelNotFound := FALSE;
	            #fTarget := #ifEncoder;

	            IF #ixEnable AND NOT #ixAbort THEN
	                #xFirstStandby := TRUE;
	                #iState := #ST_STANDBY;
	            ELSIF (#ixJogPos XOR #ixJogNeg) AND NOT #ixAbort THEN
	                IF #ixJogPos THEN
	                    #rDir := 1.0;
	                ELSE
	                    #rDir := -1.0;
	                END_IF;
	                #iState := #ST_JOG_START;
	            END_IF;

	        10:  // ST_STANDBY
	            #fVirPos := #ifEncoder;
	            #txProfileReset := TRUE;

	            IF NOT #ixEnable OR #ixAbort THEN
	                #iState := #ST_DISABLED;
	            ELSIF #xFirstStandby THEN
	                // all'abilitazione si porta sulla quota richiesta
	                #xFirstStandby := FALSE;
	                #fAcceptedRequest := #ifPositionRequest;
	                IF ABS(#ifPositionRequest - #ifEncoder) > #Cfg.fMotWindPos THEN
	                    #fNewTarget := #ifPositionRequest;
	                    #xStartMove := TRUE;
	                ELSE
	                    #fTarget := #ifPositionRequest;
	                END_IF;
	            ELSIF #ifPositionRequest <> #fAcceptedRequest THEN
	                // nuova quota
	                #fAcceptedRequest := #ifPositionRequest;
	                #fNewTarget := #ifPositionRequest;
	                #xStartMove := TRUE;
	            ELSIF #Cfg.fReposWindow > 0.0 AND NOT #xLevelFound
	                AND ABS(#fTarget - #ifEncoder) > #Cfg.fReposWindow THEN
	                // riposizionamento: l'asse è uscito dalla finestra da fermo
	                #fNewTarget := #fTarget;
	                #xStartMove := TRUE;
	            END_IF;

	        20:  // ST_START: marcia comandata, riferimento 0, attesa inverter magnetizzato
	            #fVirPos := #ifEncoder;
	            #txProfileReset := TRUE;
	            #rOutDir := #rDir;
	            IF NOT #ixEnable THEN
	                #iState := #ST_DISABLED;
	            ELSIF #ixDriveReady THEN
	                #xBrakeOpen := TRUE;
	                #iState := #ST_MOVING;
	            END_IF;

	        30:  // ST_MOVING
	            // --- cambio quota durante il moto
	            IF #ifPositionRequest <> #fAcceptedRequest THEN
	                #fAcceptedRequest := #ifPositionRequest;
	                #fTarget := #ifPositionRequest;
	                #tfRemNew := #rDir * (#ifPositionRequest - #tfPosRef);
	                IF #Cfg.xPosLoop THEN
	                    #tfLagComp := 0.0;
	                ELSE
	                    #tfLagComp := (#fProfSpeed - #tfVEnd) * #tfAdv;
	                END_IF;
	                IF #tfRemNew >= #Cfg.fMotWindPos + #Cfg.fMotAdvStopPosition + #tfLagComp
	                    + "AxisAS_RampDist_v4"(ifV0 := #fProfSpeed, ifA0 := #tfAccAlong, ifV1 := #tfVEnd,
	                                           ifDec := #fDecWork, ifJerk := #Cfg.fJerk) THEN
	                    // stessa direzione e c'è spazio per fermarsi: aggiorno solo l'obiettivo
	                    #xDecel := FALSE;
	                ELSE
	                    // direzione opposta o troppo vicino: arresto in rampa e ripartenza
	                    #xRestart := TRUE;
	                    #iState := #ST_STOPPING;
	                END_IF;
	            END_IF;

	            IF NOT #ixEnable THEN
	                #xRestart := FALSE;
	                #iState := #ST_STOPPING;
	            END_IF;

	            // --- ricerca livello
	            IF #ixLevelSearch AND #iState = #ST_MOVING THEN
	                IF #ixLevelSensor THEN
	                    #xLevelFound := TRUE;
	                    #xRestart := FALSE;
	                    #iState := #ST_STOPPING;
	                ELSIF NOT #xLevelPhase THEN
	                    #ofSpaceLevRes := "AxisAS_RampDist_v4"(ifV0 := #fProfSpeed, ifA0 := #tfAccAlong, ifV1 := #ifSpeedLev,
	                                                           ifDec := #fDecWork, ifJerk := #Cfg.fJerk)
	                    + #Cfg.fOffSResLevel;
	                    IF #rDir * (#ifPositionStartLev - #ifEncoder) <= #ofSpaceLevRes THEN
	                        #xLevelPhase := TRUE;
	                    END_IF;
	                END_IF;
	            END_IF;

	            IF #iState = #ST_MOVING THEN
	                // --- velocità obiettivo
	                #tfVCruise := #fSpeedMove;
	                IF #xLevelPhase AND #ifSpeedLev < #tfVCruise THEN
	                    #tfVCruise := #ifSpeedLev;
	                END_IF;
	                IF #tfVCruise < #tfVEnd THEN
	                    #tfVCruise := #tfVEnd;
	                END_IF;

	                // --- inizio decelerazione: spazio residuo reale (previsto al prossimo ciclo) <= spazio di arresto
	                #tfRem := #rDir * (#fTarget - #tfPosRef) - #fProfSpeed * #fDt;
	                // spazio di arresto = finestra + anticipo fisso + ritardo meccanica (tAdvStop x calo di velocità) + rampa
	                // con xPosLoop il ritardo è compensato dall'anticipo sull'accelerazione: niente tfLagComp
	                IF #Cfg.xPosLoop THEN
	                    #tfLagComp := 0.0;
	                ELSE
	                    #tfLagComp := (#fProfSpeed - #tfVEnd) * #tfAdv;
	                END_IF;
	                #ofSpaceStop := #Cfg.fMotWindPos + #Cfg.fMotAdvStopPosition + #tfLagComp
	                + "AxisAS_RampDist_v4"(ifV0 := #fProfSpeed, ifA0 := #tfAccAlong, ifV1 := #tfVEnd,
	                                       ifDec := #fDecWork, ifJerk := #Cfg.fJerk);
	                IF #tfRem <= #ofSpaceStop THEN
	                    #xDecel := TRUE;
	                END_IF;

	                IF #xDecel THEN
	                    #tfCmd := #tfVEnd;
	                ELSE
	                    #tfCmd := #tfVCruise;
	                END_IF;

	                // --- profilo
	                #Profile(ifCmdSpeed := #tfCmd,
	                         ifAcc := #fAccWork,
	                         ifDec := #fDecWork,
	                         ifJerk := #Cfg.fJerk,
	                         ifDt := #fDt,
	                         ixReset := FALSE);
	                #fProfSpeed := #Profile.ofSpeed;
	                #fVirPos := #fVirPos + #rDir * #fProfSpeed * #fDt;
	                // con xPosLoop il virtuale non supera la quota
	                IF #Cfg.xPosLoop AND #rDir * (#fTarget - #fVirPos) <= 0.0 THEN
	                    #fVirPos := #fTarget;
	                END_IF;

	                #fOutSpeed := #fProfSpeed;
	                IF #Cfg.xPosLoop THEN
	                    // anticipo sull'accelerazione + correzione proporzionale (limitata)
	                    #tfP := #Cfg.fKp_Pos * #rDir * (#fVirPos - #ifEncoder);
	                    IF #tfP > #tfPLim THEN
	                        #tfP := #tfPLim;
	                    ELSIF #tfP < -#tfPLim THEN
	                        #tfP := -#tfPLim;
	                    END_IF;
	                    #fOutSpeed := #fProfSpeed + #Profile.ofAcc * #tfAdv + #tfP;
	                    // può scendere fino a 0 per frenare il motore se è più avanti del virtuale
	                    IF #fOutSpeed < 0.0 THEN
	                        #fOutSpeed := 0.0;
	                    END_IF;
	                ELSIF #fOutSpeed < #tfVEnd THEN
	                    #fOutSpeed := #tfVEnd;
	                END_IF;
	                #rOutDir := #rDir;

	                // --- arrivo: encoder in finestra, oppure posizione prevista a motore fermo (inerzia) già in quota
	                #tfRem := #rDir * (#fTarget - #ifEncoder);
	                #tfPred := #tfRem - #rDir * #fEncSpeed * #tfAdv;
	                // arrivo a metà finestra: margine per assestamenti e cedimenti del carico
	                IF #tfRem <= 0.5 * #Cfg.fMotWindPos OR (NOT #Cfg.xPosLoop AND #xDecel AND #tfAdv > 0.0 AND #tfPred <= 0.0)
	                    OR (#Cfg.xPosLoop AND #xDecel AND #fVirPos = #fTarget) THEN
	                    IF #ixLevelSearch THEN
	                        #xLevelNotFound := TRUE;
	                    END_IF;
	                    #fOutSpeed := 0.0;
	                    #txProfileReset := TRUE;
	                    #xSettleCreep := FALSE;
	                    #fMaxOvershoot := #rDir * (#ifEncoder - #fTarget);
	                    #iState := #ST_SETTLE;
	                END_IF;
	            END_IF;

	        40:  // ST_SETTLE: accostamento finale
	            #fVirPos := #fTarget;
	            #txProfileReset := TRUE;
	            #tfErr := #fTarget - #ifEncoder;
	            IF #rDir * (#ifEncoder - #fTarget) > #fMaxOvershoot THEN
	                #fMaxOvershoot := #rDir * (#ifEncoder - #fTarget);
	            END_IF;

	            IF NOT #ixEnable THEN
	                #iNextState := #ST_DISABLED;
	                #iState := #ST_BRAKE;
	            ELSIF #ixLevelSearch AND #ixLevelSensor AND NOT #xLevelFound THEN
	                #xLevelFound := TRUE;
	                #xLevelNotFound := FALSE;
	                #fTarget := #ifEncoder;
	                #iNextState := #ST_STANDBY;
	                #iState := #ST_BRAKE;
	            ELSIF #ifPositionRequest <> #fAcceptedRequest THEN
	                #fAcceptedRequest := #ifPositionRequest;
	                #fNewTarget := #ifPositionRequest;
	                #xStartMove := TRUE;
	            ELSIF ABS(#tfErr) > #Cfg.fMotWindPos AND NOT #xSettleCreep AND ABS(#fEncSpeed) > #Cfg.fMotWindSpeed THEN
	                // fuori finestra con motore ancora in moto per inerzia: riferimento 0, attendo che si fermi
	                #fOutSpeed := 0.0;
	            ELSE
	                IF ABS(#tfErr) > #Cfg.fMotWindPos THEN
	                    #xSettleCreep := TRUE;
	                END_IF;
	                IF #tfErr > 0.0 THEN
	                    #rOutDir := 1.0;
	                ELSE
	                    #rOutDir := -1.0;
	                END_IF;
	                // correzione a velocità minima verso il centro della finestra,
	                // con taglio anticipato se per inerzia ci arriverebbe comunque
	                #tfPred := ABS(#tfErr) - 0.5 * #Cfg.fMotWindPos - #rOutDir * #fEncSpeed * #tfAdv;
	                IF #xSettleCreep AND #tfPred > 0.0 THEN
	                    #fOutSpeed := #tfVEnd;
	                ELSIF ABS(#tfErr) <= #Cfg.fMotWindPos AND ABS(#fEncSpeed) <= #Cfg.fMotWindSpeed THEN
	                    // fermo in finestra: fine posizionamento
	                    #xSettleCreep := FALSE;
	                    #ofOvershoot := #fMaxOvershoot;
	                    #ofStopError := -#tfErr;
	                    #iNextState := #ST_STANDBY;
	                    #iState := #ST_BRAKE;
	                END_IF;
	                // altrimenti riferimento 0 e attendo l'arresto
	            END_IF;

	        50:  // ST_STOPPING: arresto in rampa (disabilitazione, inversione, sensore livello)
	            #Profile(ifCmdSpeed := 0.0,
	                     ifAcc := #fAccWork,
	                     ifDec := #fDecWork,
	                     ifJerk := #Cfg.fJerk,
	                     ifDt := #fDt,
	                     ixReset := FALSE);
	            #fProfSpeed := #Profile.ofSpeed;
	            #fVirPos := #fVirPos + #rDir * #fProfSpeed * #fDt;
	            #fOutSpeed := #fProfSpeed;
	            #rOutDir := #rDir;

	            IF #fProfSpeed <= 0.0 AND ABS(#fEncSpeed) <= #Cfg.fMotWindSpeed THEN
	                #txProfileReset := TRUE;
	                IF #xLevelFound THEN
	                    #fTarget := #ifEncoder;
	                    #iNextState := #ST_STANDBY;
	                    #iState := #ST_BRAKE;
	                ELSIF #xRestart AND #ixEnable THEN
	                    #xRestart := FALSE;
	                    #fNewTarget := #fTarget;
	                    #xStartMove := TRUE;
	                ELSIF #ixEnable THEN
	                    #iNextState := #ST_STANDBY;
	                    #iState := #ST_BRAKE;
	                ELSE
	                    #iNextState := #ST_DISABLED;
	                    #iState := #ST_BRAKE;
	                END_IF;
	            END_IF;

	        60:  // ST_BRAKE: riferimento 0, freno ancora aperto per il tempo di ritardo
	            #txProfileReset := TRUE;
	            IF #rDir > 0.0 THEN
	                #tfBrakeDelay := DINT_TO_REAL(TIME_TO_DINT(#Cfg.tBrakeDelay_Fwd)) / 1000.0;
	            ELSE
	                #tfBrakeDelay := DINT_TO_REAL(TIME_TO_DINT(#Cfg.tBrakeDelay_Bkw)) / 1000.0;
	            END_IF;
	            IF #fStateTime >= #tfBrakeDelay THEN
	                #xBrakeOpen := FALSE;
	                IF #iNextState = #ST_STANDBY THEN
	                    #otTimeMove := DINT_TO_TIME(REAL_TO_DINT(#fMoveTime * 1000.0));
	                END_IF;
	                #iState := #iNextState;
	            END_IF;

	        70:  // ST_JOG_START
	            #fVirPos := #ifEncoder;
	            #txProfileReset := TRUE;
	            #rOutDir := #rDir;
	            IF #ixEnable OR NOT ((#rDir > 0.0 AND #ixJogPos AND NOT #ixJogNeg) OR (#rDir < 0.0 AND #ixJogNeg AND NOT #ixJogPos)) THEN
	                #iState := #ST_DISABLED;
	            ELSIF #ixDriveReady THEN
	                #xBrakeOpen := TRUE;
	                #iState := #ST_JOG;
	            END_IF;

	        71:  // ST_JOG
	            #fVirPos := #ifEncoder;
	            IF NOT #ixEnable AND ((#rDir > 0.0 AND #ixJogPos AND NOT #ixJogNeg) OR (#rDir < 0.0 AND #ixJogNeg AND NOT #ixJogPos)) THEN
	                #tfCmd := #Cfg.fJogSpeed;
	            ELSE
	                #tfCmd := 0.0;
	            END_IF;
	            #Profile(ifCmdSpeed := #tfCmd,
	                     ifAcc := #Cfg.fJogAcc,
	                     ifDec := #Cfg.fJogDec,
	                     ifJerk := #Cfg.fJerk,
	                     ifDt := #fDt,
	                     ixReset := FALSE);
	            #fProfSpeed := #Profile.ofSpeed;
	            #fOutSpeed := #fProfSpeed;
	            #rOutDir := #rDir;
	            IF #tfCmd = 0.0 AND #fProfSpeed <= 0.0 THEN
	                #txProfileReset := TRUE;
	                #iNextState := #ST_DISABLED;
	                #iState := #ST_BRAKE;
	            END_IF;

	        99:  // ST_ERROR
	            #fVirPos := #ifEncoder;
	            #txProfileReset := TRUE;
	            #xBrakeOpen := FALSE;
	            #xRestart := FALSE;

	        ELSE
	            #iState := #ST_DISABLED;
	    END_CASE;
	END_REGION

	REGION Avvio movimento
	    IF #xStartMove THEN
	        #tfDist := ABS(#fNewTarget - #ifEncoder);
	        #fTarget := #fNewTarget;
	        #txProfileReset := TRUE;
	        #xDecel := FALSE;
	        #xRestart := FALSE;
	        #xSettleCreep := FALSE;
	        #xLevelPhase := FALSE;
	        #xLevelFound := FALSE;
	        #xLevelNotFound := FALSE;
	        #fMaxOvershoot := 0.0;
	        #fVirPos := #ifEncoder;
	        #ofMaxFollowingError := 0.0;

	        IF #Cfg.fMaxSpeed <= 0.0 OR #Cfg.fMinSpeed <= 0.0 OR #Cfg.fMinSpeed > #Cfg.fMaxSpeed
	            OR #Cfg.fMinAccRamp <= 0.0 OR #Cfg.fMinDecRamp <= 0.0
	            OR #Cfg.fMaxAccRamp < #Cfg.fMinAccRamp OR #Cfg.fMaxDecRamp < #Cfg.fMinDecRamp
	            OR #Cfg.fJerk < 0.0 OR #Cfg.fMotWindPos <= 0.0
	            OR (#Cfg.xPosLoop AND (#Cfg.fKp_Pos < 0.0 OR #Cfg.fPosLoopLimitPct < 0.0)) THEN
	            #wError := #ERR_PARAM;
	            #iState := #ST_ERROR;

	        ELSIF #tfDist <= #Cfg.fMotWindPos THEN
	            // già in posizione
	            IF #xBrakeOpen THEN
	                #iNextState := #ST_STANDBY;
	                #iState := #ST_BRAKE;
	            ELSE
	                #iState := #ST_STANDBY;
	            END_IF;

	        ELSE
	            IF #fNewTarget > #ifEncoder THEN
	                #rDir := 1.0;
	            ELSE
	                #rDir := -1.0;
	            END_IF;

	            // autocalcolo velocità sullo spazio da percorrere
	            IF #ixAutoSpeed THEN
	                #fSpeedMove := #ifSpeedRequest;
	                IF #tfDist <= #Cfg.fThreshold_SUP_AutoSpeed
	                    AND #Cfg.fThreshold_SUP_AutoSpeed > #Cfg.fThreshold_INF_AutoSpeed THEN
	                    #tfX := #tfDist;
	                    IF #tfX < #Cfg.fThreshold_INF_AutoSpeed THEN
	                        #tfX := #Cfg.fThreshold_INF_AutoSpeed;
	                    END_IF;
	                    #tfM := (#Cfg.fMaxSpeed - #Cfg.fMinSpeed)
	                    / (#Cfg.fThreshold_SUP_AutoSpeed - #Cfg.fThreshold_INF_AutoSpeed);
	                    #tfX := #Cfg.fMinSpeed + #tfM * (#tfX - #Cfg.fThreshold_INF_AutoSpeed);
	                    IF #tfX < #fSpeedMove THEN
	                        #fSpeedMove := #tfX;
	                    END_IF;
	                END_IF;
	                IF #fSpeedMove > #tfMaxSpeed THEN
	                    #fSpeedMove := #tfMaxSpeed;
	                END_IF;
	                IF #fSpeedMove < #Cfg.fMinSpeed THEN
	                    #fSpeedMove := #Cfg.fMinSpeed;
	                END_IF;
	            END_IF;

	            IF #iState <> #ST_SETTLE AND #iState <> #ST_STOPPING THEN
	                #fMoveTime := 0.0;
	            END_IF;

	            IF #xBrakeOpen AND #ixDriveReady THEN
	                #iState := #ST_MOVING;
	            ELSE
	                #iState := #ST_START;
	            END_IF;
	        END_IF;
	    END_IF;

	    IF #txProfileReset THEN
	        #Profile(ifCmdSpeed := 0.0,
	                 ifAcc := #fAccWork,
	                 ifDec := #fDecWork,
	                 ifJerk := #Cfg.fJerk,
	                 ifDt := #fDt,
	                 ixReset := TRUE);
	        #fProfSpeed := 0.0;
	    END_IF;
	END_REGION

	REGION Uscite
	    #txActive := (#iState >= #ST_START) AND (#iState <> #ST_ERROR);

	    // durata movimento
	    IF #iState >= #ST_START AND #iState <= #ST_BRAKE THEN
	        #fMoveTime := #fMoveTime + #fDt;
	    END_IF;

	    // mantenimento marcia dopo l'arresto (inverter magnetizzato)
	    IF #ixMotorReadyReq AND NOT #xMotorReqOld AND #ixEnable THEN
	        #fKeepAlive := DINT_TO_REAL(TIME_TO_DINT(#Cfg.tDriveOnReq)) / 1000.0;
	    END_IF;
	    #xMotorReqOld := #ixMotorReadyReq;
	    IF #txActive AND #iState <> #ST_JOG_START AND #iState <> #ST_JOG THEN
	        #fKeepAlive := DINT_TO_REAL(TIME_TO_DINT(#Cfg.tDriveOnReq)) / 1000.0;
	    ELSIF #fKeepAlive > 0.0 THEN
	        #fKeepAlive := #fKeepAlive - #fDt;
	    END_IF;
	    IF NOT #ixEnable OR #iState = #ST_ERROR THEN
	        #fKeepAlive := 0.0;
	    END_IF;

	    IF #txActive THEN
	        #rLastDir := #rOutDir;
	    END_IF;

	    // comandi marcia
	    IF #ixAbort OR #iState = #ST_ERROR THEN
	        #oxCmdMotorForw := FALSE;
	        #oxCmdMotorBack := FALSE;
	    ELSIF #txActive THEN
	        #oxCmdMotorForw := #rOutDir > 0.0;
	        #oxCmdMotorBack := #rOutDir < 0.0;
	    ELSIF #fKeepAlive > 0.0 THEN
	        #oxCmdMotorForw := #rLastDir > 0.0;
	        #oxCmdMotorBack := #rLastDir < 0.0;
	    ELSE
	        #oxCmdMotorForw := FALSE;
	        #oxCmdMotorBack := FALSE;
	    END_IF;

	    // freno e riferimento velocità
	    #oxCmdBrake := #xBrakeOpen AND #ixDriveReady AND NOT #ixAbort;
	    IF #oxCmdBrake AND #txActive THEN
	        // con xPosLoop la correzione può superare fMaxSpeed di fPosLoopLimitPct
	        IF #Cfg.xPosLoop THEN
	            #tfX := #tfMaxSpeed + #tfPLim;
	        ELSE
	            #tfX := #tfMaxSpeed;
	        END_IF;
	        IF #fOutSpeed > #tfX THEN
	            #fOutSpeed := #tfX;
	        END_IF;
	        #ofSpeedRequest := #fOutSpeed;
	    ELSE
	        #ofSpeedRequest := 0.0;
	    END_IF;
	    #fOutSpeedOld := #ofSpeedRequest;

	    // stato
	    #oxStopSpeed := (#ofSpeedRequest = 0.0);
	    #oxBusy := (#iState >= #ST_START) AND (#iState <= #ST_BRAKE);
	    #oxAccOnWork := (#iState = #ST_MOVING OR #iState = #ST_JOG) AND #Profile.oxAcc;
	    #oxDecOnWork := (#iState = #ST_MOVING OR #iState = #ST_STOPPING OR #iState = #ST_JOG) AND #Profile.oxDec;
	    #oxEndPos := ((#iState = #ST_STANDBY) OR (#iState = #ST_BRAKE AND #iNextState = #ST_STANDBY))
	    AND NOT #xLevelFound AND (ABS(#fTarget - #ifEncoder) <= #Cfg.fMotWindPos);
	    #oxEndPosBig := #ixEnable AND (#iState <> #ST_ERROR) AND (ABS(#fTarget - #ifEncoder) <= #Cfg.fMotWindPosBig);
	    #oxLevelReached := #xLevelFound AND #ixLevelSearch;
	    #oxLevelNotFound := #xLevelNotFound AND #ixLevelSearch;
	    #oxPosError := (#iState = #ST_ERROR);
	    #owErrorId := #wError;
	    #oiState := #iState;
	    #ofProfileSpeed := #rDir * #fProfSpeed;
	    #ofProfileAcc := #rDir * #Profile.ofAcc;
	    #ofActualPos := #ifEncoder;
	    #ofActualSpeed := #fEncSpeed;
	    #ofVirPos := #fVirPos;
	    #ofTarget := #fTarget;
	    #ofSpeedMove := #fSpeedMove;
	    #ofAccWork := #fAccWork;
	    #ofDecWork := #fDecWork;
	    #ofFollowingError := #rDir * (#fVirPos - #ifEncoder);
	    #ofSpaceStart := "AxisAS_RampDist_v4"(ifV0 := #fSpeedMove, ifA0 := 0.0, ifV1 := 0.0,
	                                          ifDec := #fAccWork, ifJerk := #Cfg.fJerk);
	    IF #iState <> #ST_MOVING THEN
	        #ofSpaceStop := "AxisAS_RampDist_v4"(ifV0 := #fProfSpeed, ifA0 := #tfAccAlong, ifV1 := 0.0,
	                                             ifDec := #fDecWork, ifJerk := #Cfg.fJerk);
	    END_IF;
	END_REGION
END_FUNCTION_BLOCK









