FUNCTION "AxisAS_RampDist_v4" : Real
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : FMT
FAMILY : AxisAS
VERSION : 0.1
//Spazio necessario per passare dalla velocità ifV0 alla velocità ifV1 con accelerazione/decelerazione di picco ifA,
//per la curva iiCurve (0 = TRAPEZIO, 1 = LOGARITMICA, 2 = COSENO). Stesse formule di AxisAS_Profile_v4.
   VAR_INPUT
      ifV0 : Real;   // Velocità iniziale (>= 0)
      ifV1 : Real;   // Velocità finale (>= 0)
      ifA : Real;   // Acc./dec. di picco
      iiCurve : Int;   // Curva
      ifNepero : Real;   // Pendenza sigmoide (curva 1)
   END_VAR

   VAR_TEMP
      tfC : Real;
      tfN : Real;
      tfFactor : Real;
   END_VAR

   VAR CONSTANT
      PI_R : Real := 3.1415927;
   END_VAR


BEGIN
	CASE #iiCurve OF
	    1:
	        #tfC := #ifNepero;
	        IF #tfC < 1.0 THEN
	            #tfC := 6.0;
	        END_IF;
	        #tfN := 1.0 / (1.0 + EXP(-#tfC)) - 1.0 / (1.0 + EXP(#tfC));
	        #tfFactor := #tfC / (2.0 * #tfN);
	    2:
	        #tfFactor := #PI_R / 2.0;
	    ELSE
	        #tfFactor := 1.0;
	END_CASE;

	IF #ifA > 0.0 THEN
	    #AxisAS_RampDist_v4 := (#ifV0 + #ifV1) * 0.5 * #tfFactor * ABS(#ifV1 - #ifV0) / #ifA;
	ELSE
	    #AxisAS_RampDist_v4 := 0.0;
	END_IF;
END_FUNCTION

