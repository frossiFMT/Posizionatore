FUNCTION_BLOCK "AxisAS_Trace_v4"
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : FMT
FAMILY : AxisAS
VERSION : 0.2
//Traiettoria prevista e registrazione del moto reale per AxisAS_Mng_v4, per il trend view dei pannelli Comfort
//in modalità "buffer comandato da bit" (bit-triggered buffer).
//  - Alla partenza di ogni movimento (asse in moto, dopo la magnetizzazione) calcola la traiettoria prevista (posizione e velocità,
//    999 punti, calcolo distribuito su più cicli) con gli stessi parametri dell'asse e avvia la registrazione di encoder e velocità reale
//    con la stessa scala di tempo: le curve si sovrappongono.
//  - Con ixPreview (fronte) calcola la traiettoria prevista dalla posizione attuale a ifPreviewTarget, senza muovere.
//  - wTrendTransfer (consegnato con fronte, vedi REGION Consegna al pannello): bit 0 = posizione prevista, bit 1 = posizione reale, bit 2 = velocità prevista,
//    bit 3 = velocità reale. Il blocco alza il bit quando l'array è pronto, il pannello lo legge e lo azzera.
//    Durante la registrazione, con ixLive, i bit 1 e 3 vengono rialzati ogni LIVE_PERIOD secondi (aggiornamento in moto);
//    senza ixLive il grafico reale viene consegnato una sola volta a fine moto (una sola lettura del pannello).
//  - Scala del tempo: ofSampleTime secondi per punto (asse X del trend = N_LAST+1 = 999 punti: nel trend view
//    impostare 999 valori per curva, il massimo consentito, altrimenti si vede solo l'inizio del movimento).
//CHANGELOG:
//    v0.2 - 26/11/2026 - buffer da 1000 a 999 punti (limite del trend view WinCC);
//                        registrazione prolungata di POST_TIME dopo l'arrivo, poi velocità reale a 0 nei punti restanti
//                        (prima restava l'ultima velocità misurata, es. 4 mm/s, come se il motore si muovesse ancora)
//Profilo previsto ideale: motore che segue esattamente il riferimento (nessun ritardo/inerzia/slittamento);
//la differenza con il reale mostra l'effetto della meccanica.
   VAR_INPUT
      ixPreview : Bool;   // Fronte: calcola traiettoria prevista da posizione attuale a ifPreviewTarget
      ifPreviewTarget : Real;   // Quota per l'anteprima (mm)
      ifPreviewSpeed : Real;   // Velocità per l'anteprima (mm/s)
      ifPreviewAcc : Real;   // Accelerazione per l'anteprima (mm/s^2)
      ifPreviewDec : Real;   // Decelerazione per l'anteprima (mm/s^2)
      ixBusy : Bool;   // Asse in movimento (AxisAS_Mng_v4.oxBusy)
      iiAxisState : Int;   // Stato dell'asse (AxisAS_Mng_v4.oiState): la registrazione parte con il moto (stato 30)
      ifEncoder : Real;   // Posizione encoder (mm)
      ifActualSpeed : Real;   // Velocità reale (AxisAS_Mng_v4.ofActualSpeed), nel grafico mediata sul passo
      ifTarget : Real;   // Quota del movimento (AxisAS_Mng_v4.ofTarget)
      ifSpeedMove : Real;   // Velocità di lavoro (AxisAS_Mng_v4.ofSpeedMove)
      ifAccWork : Real;   // Accelerazione di lavoro (AxisAS_Mng_v4.ofAccWork)
      ifDecWork : Real;   // Decelerazione di lavoro (AxisAS_Mng_v4.ofDecWork)
      ixLive : Bool := TRUE;   // Aggiorna il grafico reale anche durante il moto (FALSE = solo a fine moto)
   END_VAR

   VAR_OUTPUT
      ofSampleTime : Real;   // Secondi per punto del grafico
      ofWindowTime : Real;   // Durata totale del grafico (s) = N_LAST x ofSampleTime
      ofPlanTime : Real;   // Durata prevista del posizionamento (s)
      ofActTime : Real;   // Durata reale registrata (s)
      ofPosMin : Real;   // Limite inferiore suggerito per l'asse posizione
      ofPosMax : Real;   // Limite superiore suggerito per l'asse posizione
      ofSpeedMax : Real;   // Limite superiore suggerito per l'asse velocità
      oxRecording : Bool;   // Registrazione in corso
      oxPlanning : Bool;   // Calcolo della traiettoria prevista in corso
   END_VAR

   VAR_IN_OUT
      Cfg : "AxisAS_CFG_Type_v4";   // Configurazione dell'asse
   END_VAR

   VAR
      aPlanPos : Array[0..998] of Real;   // Posizione prevista (999 valori = massimo di una curva del trend view; limite superiore = N_LAST)
      aActPos : Array[0..998] of Real;   // Posizione reale
      aPlanSpd : Array[0..998] of Real;   // Velocità prevista (modulo)
      aActSpd : Array[0..998] of Real;   // Velocità reale (modulo)
      wTrendTransfer : Word;   // Bit di trasferimento per il trend view (il pannello li azzera)
      wTrendRequest : Word;   // Requisiti curva: scritta dal pannello (curve visualizzate), non usata dal PLC
      wTrendPend : Word;   // Bit da consegnare al pannello (in attesa)
      xTrendLow : Bool;   // Bit abbassati in attesa di rialzarli (il pannello reagisce al cambio di valore)
      fTrendLowT : Real;   // Tempo trascorso con i bit abbassati [s]
      Prof : "AxisAS_Profile_v4";   // Generatore per il calcolo della traiettoria prevista
      lrRuntimeMem : LReal;
      xInitDone : Bool;
      xPreviewOld : Bool;
      xStarted : Bool;   // Registrazione già avviata in questo movimento
      xPlanReq : Bool;
      fPlanStart : Real;
      fPlanTarget : Real;
      fPlanSpeed : Real;
      fPlanAcc : Real;
      fPlanDec : Real;
      fTs : Real := 0.05;   // Tempo per punto (s)
      fActT : Real;   // Tempo dall'inizio della registrazione (s)
      iActIdx : Int;   // Prossimo punto da registrare
      fLiveT : Real;   // Tempo dall'ultimo aggiornamento in moto (s)
      iPlanIdx : Int;   // Prossimo punto della traiettoria prevista da calcolare
      fPlD : Real;   // Dati della traiettoria prevista mantenuti tra i cicli
      fPlDir : Real;
      fPlV : Real;
      fPlVEnd : Real;
      fPlA : Real;
      fPlDc : Real;
      fPlJ : Real;
      fPlAdv : Real;
      fPlDtI : Real;
      fPlS : Real;
      fPlSp : Real;
      fPlArr : Real;
      xPlDec : Bool;
      xPlArrived : Bool;
      fRecSpdSum : Real;   // Integrale della velocità reale dall'ultimo punto registrato
      fRecT : Real;   // Tempo dall'ultimo punto registrato (s)
      fRecSpd : Real;   // Velocità reale media sull'ultimo passo del grafico
      fPostT : Real;   // Tempo di registrazione dopo l'arrivo (asse non più in movimento) [s]
   END_VAR

   VAR_TEMP
      tlrDt : LReal;
      tfDt : Real;
      tfD : Real;
      tfDir : Real;
      tfVEnd : Real;
      tfV : Real;
      tfA : Real;
      tfDc : Real;
      tfJ : Real;
      tfAdv : Real;
      tfLo : Real;
      tfHi : Real;
      tfMid : Real;
      tfDA : Real;
      tfDD : Real;
      tfDv : Real;
      tfTA : Real;
      tfTD : Real;
      tfT : Real;
      tfRem : Real;
      tfCmd : Real;
      ti : Int;
      tk : Int;
      tiIter : Int;
   END_VAR

   VAR CONSTANT
      N_LAST : Int := 998;   // Ultimo indice degli array (999 punti, massimo di una curva del trend view). Deve coincidere con il limite degli array
      SUBSTEPS : Int := 5;   // Passi di calcolo per punto
      PLAN_CHUNK : Int := 100;   // Punti della traiettoria prevista calcolati per ciclo PLC
      LIVE_PERIOD : Real := 0.5;   // Periodo di aggiornamento del grafico durante il moto (s)
      POST_TIME : Real := 0.5;   // Registrazione dopo l'arrivo (s): arresto reale e assestamenti dopo la chiusura del freno
      TREND_SYNC_BIT : Word := 16#8000;   // Bit 15 di wTrendTransfer richiesto dal pannello insieme ai bit delle curve
   END_VAR


BEGIN
	REGION Tempo ciclo
	    #tlrDt := RUNTIME(#lrRuntimeMem);
	    IF #xInitDone THEN
	        #tfDt := LREAL_TO_REAL(#tlrDt);
	    ELSE
	        #tfDt := 0.0;
	        #xInitDone := TRUE;
	    END_IF;
	    IF #tfDt < 0.0 OR #tfDt > 1.0 THEN
	        #tfDt := 0.0;
	    END_IF;
	END_REGION

	REGION Richieste
	    #xPlanReq := FALSE;
	    // anteprima a richiesta (solo da fermo)
	    IF #ixPreview AND NOT #xPreviewOld AND NOT #ixBusy THEN
	        #fPlanStart := #ifEncoder;
	        #fPlanTarget := #ifPreviewTarget;
	        #fPlanSpeed := #ifPreviewSpeed;
	        #fPlanAcc := #ifPreviewAcc;
	        #fPlanDec := #ifPreviewDec;
	        #xPlanReq := TRUE;
	    END_IF;
	    #xPreviewOld := #ixPreview;

	    // partenza del moto (dopo la magnetizzazione): traiettoria prevista con i valori di lavoro e avvio registrazione
	    IF NOT #ixBusy THEN
	        #xStarted := FALSE;
	    END_IF;
	    IF #ixBusy AND #iiAxisState >= 30 AND NOT #xStarted THEN
	        #xStarted := TRUE;
	        #fPlanStart := #ifEncoder;
	        #fPlanTarget := #ifTarget;
	        #fPlanSpeed := #ifSpeedMove;
	        #fPlanAcc := #ifAccWork;
	        #fPlanDec := #ifDecWork;
	        #xPlanReq := TRUE;
	        #oxRecording := TRUE;
	        #iActIdx := 0;
	        #fActT := 0.0;
	        #fLiveT := 0.0;
	        #fRecSpdSum := 0.0;
	        #fRecT := 0.0;
	        #fPostT := 0.0;
	        FOR #ti := 0 TO #N_LAST DO
	            #aActPos[#ti] := #ifEncoder;
	            #aActSpd[#ti] := 0.0;
	        END_FOR;
	    END_IF;
	END_REGION

	REGION Traiettoria prevista
	    IF #xPlanReq THEN
	        #tfD := ABS(#fPlanTarget - #fPlanStart);
	        IF #fPlanTarget >= #fPlanStart THEN
	            #tfDir := 1.0;
	        ELSE
	            #tfDir := -1.0;
	        END_IF;

	        // parametri con gli stessi limiti dell'asse
	        #tfVEnd := #Cfg.fMinSpeed;
	        IF #tfVEnd <= 0.0 THEN
	            #tfVEnd := 1.0;
	        END_IF;
	        #tfV := #fPlanSpeed;
	        IF #tfV > #Cfg.fMaxSpeed THEN
	            #tfV := #Cfg.fMaxSpeed;
	        END_IF;
	        IF #tfV < #tfVEnd THEN
	            #tfV := #tfVEnd;
	        END_IF;
	        #tfA := #fPlanAcc;
	        IF #tfA < #Cfg.fMinAccRamp THEN
	            #tfA := #Cfg.fMinAccRamp;
	        END_IF;
	        IF #tfA > #Cfg.fMaxAccRamp THEN
	            #tfA := #Cfg.fMaxAccRamp;
	        END_IF;
	        #tfDc := #fPlanDec;
	        IF #tfDc < #Cfg.fMinDecRamp THEN
	            #tfDc := #Cfg.fMinDecRamp;
	        END_IF;
	        IF #tfDc > #Cfg.fMaxDecRamp THEN
	            #tfDc := #Cfg.fMaxDecRamp;
	        END_IF;
	        IF #tfA <= 0.0 THEN
	            #tfA := 1.0;
	        END_IF;
	        IF #tfDc <= 0.0 THEN
	            #tfDc := 1.0;
	        END_IF;
	        #tfJ := #Cfg.fJerk;
	        #tfAdv := #Cfg.fMotWindPos + #Cfg.fMotAdvStopPosition;   // spazio residuo all'inizio dell'accostamento

	        // velocità di crociera raggiungibile sullo spazio disponibile (bisezione)
	        #tfDA := "AxisAS_RampDist_v4"(ifV0 := #tfV, ifA0 := 0.0, ifV1 := 0.0, ifDec := #tfA, ifJerk := #tfJ);
	        #tfDD := "AxisAS_RampDist_v4"(ifV0 := #tfV, ifA0 := 0.0, ifV1 := #tfVEnd, ifDec := #tfDc, ifJerk := #tfJ);
	        IF #tfDA + #tfDD > #tfD - #tfAdv THEN
	            #tfLo := #tfVEnd;
	            #tfHi := #tfV;
	            FOR #tiIter := 1 TO 20 DO
	                #tfMid := (#tfLo + #tfHi) / 2.0;
	                IF "AxisAS_RampDist_v4"(ifV0 := #tfMid, ifA0 := 0.0, ifV1 := 0.0, ifDec := #tfA, ifJerk := #tfJ)
	                    + "AxisAS_RampDist_v4"(ifV0 := #tfMid, ifA0 := 0.0, ifV1 := #tfVEnd, ifDec := #tfDc, ifJerk := #tfJ)
	                    > #tfD - #tfAdv THEN
	                    #tfHi := #tfMid;
	                ELSE
	                    #tfLo := #tfMid;
	                END_IF;
	            END_FOR;
	            #tfV := #tfLo;
	            #tfDA := "AxisAS_RampDist_v4"(ifV0 := #tfV, ifA0 := 0.0, ifV1 := 0.0, ifDec := #tfA, ifJerk := #tfJ);
	            #tfDD := "AxisAS_RampDist_v4"(ifV0 := #tfV, ifA0 := 0.0, ifV1 := #tfVEnd, ifDec := #tfDc, ifJerk := #tfJ);
	        END_IF;

	        // durata stimata: accelerazione + regime + decelerazione + accostamento
	        #tfDv := #tfV;
	        IF #tfJ <= 0.0 THEN
	            #tfTA := #tfDv / #tfA;
	        ELSIF #tfDv >= #tfA * #tfA / #tfJ THEN
	            #tfTA := #tfDv / #tfA + #tfA / #tfJ;
	        ELSE
	            #tfTA := 2.0 * SQRT(#tfDv / #tfJ);
	        END_IF;
	        #tfDv := #tfV - #tfVEnd;
	        IF #tfDv <= 0.0 THEN
	            #tfTD := 0.0;
	        ELSIF #tfJ <= 0.0 THEN
	            #tfTD := #tfDv / #tfDc;
	        ELSIF #tfDv >= #tfDc * #tfDc / #tfJ THEN
	            #tfTD := #tfDv / #tfDc + #tfDc / #tfJ;
	        ELSE
	            #tfTD := 2.0 * SQRT(#tfDv / #tfJ);
	        END_IF;
	        #tfT := #tfTA + #tfTD + (#tfAdv - 0.5 * #Cfg.fMotWindPos) / #tfVEnd;
	        IF #tfD - #tfAdv - #tfDA - #tfDD > 0.0 THEN
	            #tfT := #tfT + (#tfD - #tfAdv - #tfDA - #tfDD) / #tfV;
	        END_IF;

	        // scala del grafico: 50% di margine per il moto reale (inerzia, accostamento)
	        #fTs := #tfT * 1.5 / INT_TO_REAL(#N_LAST);
	        IF #fTs < 0.002 THEN
	            #fTs := 0.002;   // minimo 2 ms (movimenti brevi)
	        END_IF;

	        // stato iniziale della simulazione, poi calcolo distribuito su più cicli (PLAN_CHUNK punti per ciclo)
	        #Prof(ifCmdSpeed := 0.0, ifAcc := #tfA, ifDec := #tfDc, ifJerk := #tfJ, ifDt := 0.0, ixReset := TRUE);
	        #fPlD := #tfD;
	        #fPlDir := #tfDir;
	        #fPlV := #tfV;
	        #fPlVEnd := #tfVEnd;
	        #fPlA := #tfA;
	        #fPlDc := #tfDc;
	        #fPlJ := #tfJ;
	        #fPlAdv := #tfAdv;
	        #fPlDtI := #fTs / INT_TO_REAL(#SUBSTEPS);
	        #fPlS := 0.0;
	        #fPlSp := 0.0;
	        #xPlDec := FALSE;
	        #xPlArrived := #tfD <= #Cfg.fMotWindPos;
	        #fPlArr := 0.0;
	        #iPlanIdx := 0;
	        #oxPlanning := TRUE;
	        #ofSampleTime := #fTs;
	        #ofWindowTime := #fTs * INT_TO_REAL(#N_LAST);
	        #ofPosMin := MIN(IN1 := #fPlanStart, IN2 := #fPlanTarget) - 0.05 * #tfD - 1.0;
	        #ofPosMax := MAX(IN1 := #fPlanStart, IN2 := #fPlanTarget) + 0.05 * #tfD + 1.0;
	        #ofSpeedMax := #tfV * 1.3;
	    END_IF;

	    // simulazione del profilo ideale (stessa logica di AxisAS_Mng_v4 senza ritardi), PLAN_CHUNK punti per ciclo
	    IF #oxPlanning THEN
	        #tiIter := #iPlanIdx + #PLAN_CHUNK - 1;
	        IF #tiIter > #N_LAST THEN
	            #tiIter := #N_LAST;
	        END_IF;
	        FOR #ti := #iPlanIdx TO #tiIter DO
	            #aPlanPos[#ti] := #fPlanStart + #fPlDir * #fPlS;
	            #aPlanSpd[#ti] := #fPlSp;
	            FOR #tk := 1 TO #SUBSTEPS DO
	                IF NOT #xPlArrived THEN
	                    #tfRem := #fPlD - #fPlS - #fPlSp * #fPlDtI;
	                    IF NOT #xPlDec THEN
	                        IF #tfRem <= #fPlAdv + "AxisAS_RampDist_v4"(ifV0 := #fPlSp, ifA0 := MAX(IN1 := #Prof.ofAcc, IN2 := 0.0),
	                                                                      ifV1 := #fPlVEnd, ifDec := #fPlDc, ifJerk := #fPlJ) THEN
	                            #xPlDec := TRUE;
	                        END_IF;
	                    END_IF;
	                    IF #xPlDec THEN
	                        #tfCmd := #fPlVEnd;
	                    ELSE
	                        #tfCmd := #fPlV;
	                    END_IF;
	                    #Prof(ifCmdSpeed := #tfCmd, ifAcc := #fPlA, ifDec := #fPlDc, ifJerk := #fPlJ, ifDt := #fPlDtI, ixReset := FALSE);
	                    #fPlSp := #Prof.ofSpeed;
	                    IF #fPlSp < #fPlVEnd THEN
	                        #fPlSp := #fPlVEnd;   // come l'asse: velocità minima già alla partenza
	                    END_IF;
	                    #fPlS := #fPlS + #fPlSp * #fPlDtI;
	                    #fPlArr := #fPlArr + #fPlDtI;
	                    IF #fPlD - #fPlS <= 0.5 * #Cfg.fMotWindPos THEN
	                        #xPlArrived := TRUE;
	                        #fPlSp := 0.0;
	                    END_IF;
	                END_IF;
	            END_FOR;
	        END_FOR;
	        #iPlanIdx := #tiIter + 1;
	        IF #iPlanIdx > #N_LAST THEN
	            #oxPlanning := FALSE;
	            #ofPlanTime := #fPlArr;
	            #wTrendPend := #wTrendPend OR 16#0005;   // posizione e velocità previste pronte
	        END_IF;
	    END_IF;
	END_REGION

	REGION Registrazione moto reale
	    IF #oxRecording THEN
	        IF #iActIdx > 0 THEN
	            #fActT := #fActT + #tfDt;
	        END_IF;
	        // media della velocità reale tra un punto del grafico e il successivo
	        #fRecSpdSum := #fRecSpdSum + ABS(#ifActualSpeed) * #tfDt;
	        #fRecT := #fRecT + #tfDt;
	        WHILE #iActIdx <= #N_LAST AND #fActT >= INT_TO_REAL(#iActIdx) * #fTs DO
	            // punto del grafico: media della velocità reale sul passo (attenua i ritardi irregolari dell'encoder)
	            IF #iActIdx = 0 THEN
	                #fRecSpd := 0.0;
	            ELSIF #fRecT > 0.0 THEN
	                #fRecSpd := #fRecSpdSum / #fRecT;
	            END_IF;   // più punti nello stesso ciclo: resta la velocità precedente
	            #fRecSpdSum := 0.0;
	            #fRecT := 0.0;
	            #aActPos[#iActIdx] := #ifEncoder;
	            #aActSpd[#iActIdx] := #fRecSpd;
	            #iActIdx := #iActIdx + 1;
	        END_WHILE;
	        // dopo l'arrivo (asse non più in movimento) registra ancora POST_TIME: arresto reale e assestamenti dopo il freno
	        IF #ixBusy THEN
	            #fPostT := 0.0;
	        ELSE
	            #fPostT := #fPostT + #tfDt;
	        END_IF;
	        // fine (POST_TIME dopo l'arrivo o array pieno): consegna finale; con ixLive anche aggiornamento periodico in moto
	        #fLiveT := #fLiveT + #tfDt;
	        #tk := 0;
	        IF #fPostT >= #POST_TIME OR #iActIdx > #N_LAST THEN
	            #oxRecording := FALSE;
	            #ofActTime := #fActT;
	            #tk := 2;
	        ELSIF #ixLive AND #fLiveT >= #LIVE_PERIOD THEN
	            #tk := 1;
	        END_IF;
	        IF #tk > 0 AND #iActIdx > 0 THEN
	            #fLiveT := 0.0;
	            // punti non ancora registrati: durante il moto restano sull'ultimo valore (la curva si allunga);
	            // a fine registrazione posizione finale e velocità 0 (asse fermo)
	            FOR #ti := #iActIdx TO #N_LAST DO
	                #aActPos[#ti] := #aActPos[#iActIdx - 1];
	                IF #tk = 2 THEN
	                    #aActSpd[#ti] := 0.0;
	                ELSE
	                    #aActSpd[#ti] := #aActSpd[#iActIdx - 1];
	                END_IF;
	            END_FOR;
	            #wTrendPend := #wTrendPend OR 16#000A;   // posizione e velocità reali
	        END_IF;
	    END_IF;
	END_REGION

	REGION Consegna al pannello
	    // Il pannello legge un array quando vede CAMBIARE il bit di trasferimento e poi lo azzera.
	    // Il pannello Comfort reagisce solo se insieme ai bit delle curve è alto anche il bit 15
	    // (TREND_SYNC_BIT, verificato in prova: 16#0005 non viene letto, 16#8005 sì).
	    // Se un bit da alzare è ancora alto (dato precedente non letto, es. pagina grafico chiusa),
	    // lo si abbassa per almeno 300 ms (> ciclo di acquisizione del tag) e poi lo si rialza.
	    IF #xTrendLow THEN
	        #fTrendLowT := #fTrendLowT + #tfDt;
	        IF #fTrendLowT >= 0.3 THEN
	            #wTrendTransfer := #wTrendTransfer OR #wTrendPend OR #TREND_SYNC_BIT;
	            #wTrendPend := 16#0000;
	            #xTrendLow := FALSE;
	        END_IF;
	    ELSIF #wTrendPend <> 16#0000 THEN
	        IF (#wTrendTransfer AND (#wTrendPend OR #TREND_SYNC_BIT)) <> 16#0000 THEN
	            #wTrendTransfer := #wTrendTransfer AND NOT (#wTrendPend OR #TREND_SYNC_BIT);
	            #xTrendLow := TRUE;
	            #fTrendLowT := 0.0;
	        ELSE
	            #wTrendTransfer := #wTrendTransfer OR #wTrendPend OR #TREND_SYNC_BIT;
	            #wTrendPend := 16#0000;
	        END_IF;
	    END_IF;
	END_REGION
END_FUNCTION_BLOCK

